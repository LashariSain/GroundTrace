# GroundTrace configuration. Copy to `.env` and fill in what you use.
# `.env` is git- and docker-ignored: never commit real keys.
# Everything is optional except GROUNDTRACE_API_KEY when serving beyond localhost.

# --- API ------------------------------------------------------------------
# Required for `serve --host 0.0.0.0` (and therefore for Docker). Use a long
# random value, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(32))"
GROUNDTRACE_API_KEY=

# --- CVE feeds ------------------------------------------------------------
# Free key raises the NVD limit from 5 to 50 requests / 30s:
# https://nvd.nist.gov/developers/request-an-api-key
GROUNDTRACE_NVD_API_KEY=
# Circuit breaker: max outbound feed requests per day.
GROUNDTRACE_MAX_DAILY_REQUESTS=5000
# How often the KEV catalog is re-downloaded (hours).
GROUNDTRACE_KEV_SYNC_HOURS=12

# --- Alerts (watcher) -----------------------------------------------------
# Slack / Discord / any webhook (payload format picked from the URL).
GROUNDTRACE_WEBHOOK_URL=
# Telegram bot: token from @BotFather, chat id of the target chat/channel.
GROUNDTRACE_TELEGRAM_BOT_TOKEN=
GROUNDTRACE_TELEGRAM_CHAT_ID=

# --- Dark-web / threat-intel sources (darkfeeds) --------------------------
# abuse.ch Auth-Key for MalwareBazaar + ThreatFox (free): https://auth.abuse.ch/
# MalwareBazaar + ThreatFox; also the fresh-sample discovery feed for the
# sandbox capture stage. Free key: https://auth.abuse.ch/
DARKFEEDS_ABUSECH_KEY=

# Hybrid Analysis (Falcon Sandbox): per-detonation network set + 24h sample
# feed. Free key on a registered account -> profile > API key. Preferred for
# the sandbox capture stage when present.
HYBRIDANALYSIS_API_KEY=

# ANY.RUN sandbox task feed. Optional and paid-tier only -- a free Community
# account issues no API key. Leave blank: discovery falls back to
# MalwareBazaar and per-sample capture uses VirusTotal.
ANYRUN_API_KEY=
# AlienVault OTX: https://otx.alienvault.com
DARKFEEDS_OTX_KEY=
# VirusTotal (hash reputation on collected signals)
DARKFEEDS_VT_KEY=
# Shodan (host/service enrichment of collected IPs)
DARKFEEDS_SHODAN_KEY=
# Ransomware leak-site claims come from RansomLook (https://www.ransomlook.io),
# a free, no-key source — nothing to configure here. (ransomware.live's free
# feed was retired; its API PRO tier is paid and is no longer used.)
# Tor SOCKS port for `darkfeeds crawl` (image built with WITH_CRAWLER=1)
DARKFEEDS_TOR_PORT=9050

# --- LLM (optional; default "offline" needs nothing) ----------------------
# offline | ollama[:model] | openai_local | gemini[:model] | openrouter[:model]
GROUNDTRACE_LLM_PROVIDER=offline
GROUNDTRACE_OLLAMA_URL=http://localhost:11434
GROUNDTRACE_GEMINI_API_KEY=
GROUNDTRACE_OPENROUTER_API_KEY=

# --- Storage (preset in the Docker image; set only for local runs) ---------
# GROUNDTRACE_DB_PATH=~/.groundtrace/groundtrace.db
# DARKFEEDS_DB_PATH=~/.darkfeeds/darkfeeds.db

# Optional: GitHub token (no scopes) for the PoC finder, 10 -> 30 searches/min
GROUNDTRACE_GITHUB_TOKEN=

# Malpedia family data is CC BY-NC-SA 3.0 (non-commercial). Set to 0 to leave it out.
# GROUNDTRACE_MALPEDIA=1

# Optional focus country: a local JSON file, see darkfeeds/focus.py.
# GROUNDTRACE_FOCUS_FILE=~/.groundtrace/focus.json

# Optional model and connection overrides.
# GROUNDTRACE_LLM_TIMEOUT=
# GROUNDTRACE_GEMINI_MODEL=
# GROUNDTRACE_OPENROUTER_MODEL=
# GROUNDTRACE_OLLAMA_MODEL=
# GROUNDTRACE_LOCAL_URL=
# GROUNDTRACE_LOCAL_MODEL=
# DARKFEEDS_TOR_HOST=
